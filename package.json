{
  "name": "queueglow-hub",
  "version": "0.1.6",
  "author": "Kausthub Pulipati",
  "license": "MIT",
  "description": "A local Windows desktop hub for focus, files, clips, music, and coding agents",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "format": "prettier --write src electron/*.cjs scripts e2e tests README.md package.json vite.config.mjs index.html",
    "format:check": "prettier --check src electron/*.cjs scripts e2e tests README.md package.json vite.config.mjs index.html",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && node scripts/package-win.cjs",
    "release:win": "npm run build && electron-builder --config scripts/electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.2",
    "@playwright/test": "^1.65.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "prettier": "3.10.1",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.kausthub.queueglowhub",
    "productName": "Queueglow Hub",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!electron/**/*.ps1",
      "!electron/**/*.cs"
    ],
    "extraResources": [
      {
        "from": "electron/agent_hook.ps1",
        "to": "agent_hook.ps1"
      },
      {
        "from": "electron/media_bridge.ps1",
        "to": "media_bridge.ps1"
      },
      {
        "from": "electron/volume.cs",
        "to": "volume.cs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QueueglowHub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Queueglow Hub"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KausthubPulipati",
        "repo": "queueglow-hub",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
